{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wpinterface-seo/local-business",
	"title": "Business Address & Hours",
	"category": "widgets",
	"description": "Your business name, address, phone, opening hours and map, from SEO → Local SEO.",
	"keywords": [ "address", "opening hours", "map", "local", "contact" ],
	"textdomain": "wpinterface-seo",
	"attributes": {
		"showName": { "type": "boolean", "default": true },
		"showAddress": { "type": "boolean", "default": true },
		"showPhone": { "type": "boolean", "default": true },
		"showEmail": { "type": "boolean", "default": false },
		"showHours": { "type": "boolean", "default": true },
		"showMap": { "type": "boolean", "default": false }
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true, "padding": true },
		"typography": { "fontSize": true, "lineHeight": true },
		"color": { "text": true, "background": true, "link": true }
	},
	"editorScript": "wpiseo-blocks"
}
