{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wpinterface-seo/html-sitemap",
	"title": "HTML Sitemap",
	"category": "widgets",
	"description": "A list of your site's pages and posts for visitors, following your XML sitemap settings.",
	"keywords": [ "sitemap", "pages", "archive", "index" ],
	"textdomain": "wpinterface-seo",
	"attributes": {
		"postTypes": { "type": "array", "items": { "type": "string" }, "default": [] },
		"showTaxonomies": { "type": "boolean", "default": false },
		"showDates": { "type": "boolean", "default": false },
		"limit": { "type": "number", "default": 100 },
		"orderBy": { "type": "string", "enum": [ "title", "date" ], "default": "title" }
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true, "padding": true },
		"typography": { "fontSize": true, "lineHeight": true },
		"color": { "text": true, "background": true, "link": true }
	},
	"editorScript": "wpiseo-blocks"
}
