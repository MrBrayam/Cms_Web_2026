{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wpinterface-seo/breadcrumbs",
	"title": "SEO Breadcrumbs",
	"category": "theme",
	"description": "Breadcrumb trail for the current page, with structured data for search engines.",
	"keywords": [ "breadcrumbs", "navigation", "seo" ],
	"textdomain": "wpinterface-seo",
	"usesContext": [ "postId", "postType" ],
	"attributes": {
		"separator": {
			"type": "string",
			"default": ""
		},
		"showOnFront": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"color": {
			"text": true,
			"background": true,
			"link": true
		}
	},
	"editorScript": "wpiseo-blocks"
}
